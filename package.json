{
  "name": "pocketlab",
  "private": true,
  "version": "1.0.0",
  "description": "PocketLab - Unofficial Desktop Editor & Preset Manager for Sonicake Pocket Master",
  "author": "hirokixd",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "electron": "electron .",
    "electron:dev": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win",
    "dist:win:portable": "vite build && electron-builder --win portable",
    "dist:linux": "vite build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.pocketlab.desktop",
    "productName": "PocketLab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PocketLab"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Audio"
    }
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.1.0"
  }
}
